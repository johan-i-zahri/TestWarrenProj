@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Qur'an Viewer</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>
<body class="bg-light">
    <div class="container mt-4">
        <div class="mb-3">
            <a href="/concordance/index.html" class="btn btn-primary">View Concordance Index</a>
        </div>
        <div class="mt-3">
            <a href="/concordance/index.html" class="btn btn-primary">Full Concordance Index</a>
            <a href="/concordance/index-grammar.html" class="btn btn-secondary">Grammar Concordance Index</a>
            <a href="/concordance/index-content.html" class="btn btn-secondary">Content Concordance Index</a>
            <a href="/concordance/summary-index.html" class="btn btn-info">Summary Concordance Table</a>
        </div>
        <div class="mb-3">
            <label for="surahSelect" class="form-label">Select Surah</label>
            <select id="surahSelect" class="form-select"></select>
        </div>
        <div id="verses" class="card p-3 bg-white shadow-sm">
            <p class="text-muted">Choose a Surah to view verses.</p>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            $.ajax({
                url: "quran-simple-clean.xml",
                dataType: "xml", // capital T
                success: function(xml) {
                    $(xml).find("sura").each(function() {
                        let surahNum = $(this).attr("index");
                        let surahName = $(this).attr("name");
                        $("#surahSelect").append(
                            $("<option>", { value: surahNum, text: surahNum + ". " + surahName })
                        );
                    });
                }
            });
        });
    </script>
</body>
</html>
